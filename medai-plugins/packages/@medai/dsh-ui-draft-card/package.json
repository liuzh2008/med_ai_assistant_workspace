{
  "name": "@medai/dsh-ui-draft-card",
  "version": "0.1.0",
  "type": "module",
  "description": "明文草稿卡片（F4，T2.5）：tool.call.toolview keyed slot 注册 medai_record_generate_sync，按 promptId 直连 F2e 明文端点渲染草稿；明文只渲染在卡片、不进模型上下文/会话日志",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "build": "tsc --noEmit",
    "test": "vitest run"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.2.0",
    "esbuild": "^0.28.2",
    "jsdom": "^24.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  }
}
