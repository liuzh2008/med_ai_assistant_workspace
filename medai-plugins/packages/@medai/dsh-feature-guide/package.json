{
  "name": "@medai/dsh-feature-guide",
  "version": "0.1.0",
  "type": "module",
  "description": "功能索求检测与页面跳转插件（G1 目录 / G2 编排 / G3 呈现触发 / G4 工作站导航执行）",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
